# ============================================================
# JakeAI Platform — Environment Configuration Template
# ============================================================

# --- Service Runtime ---
PROJECT_NAME="JakeAI Platform"
ENVIRONMENT=development
DEBUG=true
PORT=8000

# --- Upstream FinnApiGo Identity & Auth ---
# FinnApiGo runs on port 8081 locally (or 8080)
FINNAPIGO_JWKS_URL=http://localhost:8081/.well-known/jwks.json
# Provision 32 random bytes as 64 hex characters. Share only with the trusted issuer.
# Published example signing keys are retired in every environment (J01 invariant).
JWT_SECRET_KEY=
# Optional previous secret for zero-downtime key rotation
JWT_SECRET_PREVIOUS=
JWT_ALGORITHM=HS256
JWT_ISSUER=finnapigo
JWT_AUDIENCE=jakeai-service
JWT_KEY_ID=
JWT_PREVIOUS_KEY_ID=
# Immutable UTC Unix seconds of final legitimate previous-key issuance; never restart time.
JWT_PREVIOUS_LAST_ISSUED_AT=
IDENTITY_STATE_URL=
IDENTITY_STATE_KEY_ID=
IDENTITY_STATE_SECRET=
IDENTITY_STATE_CA_FILE=
IDENTITY_STATE_TIMEOUT_SECONDS=3
IDENTITY_STATE_CONCURRENCY=16
# Optional separate private operator credential; missing means operator routes hidden.
OPERATOR_METRICS_SECRET=
INTERNAL_GATEWAY_SECRET=
# Independent 32-byte hex secrets; never reuse signing/encryption/perimeter material.
FINNAPIGO_SERVICE_SECRET=
AUDIT_HMAC_KEY=

# --- Distributed Cache, State & Task Queue (Redis) ---
REDIS_URL=redis://localhost:6379/0

# --- Vector Database (Qdrant) ---
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# --- Upstream LLM Providers (Optional - Deterministic fallback used if unset) ---
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# --- Commercial FinOps & Security ---
# Canonical base64 of 32 random bytes, provisioned separately from stored ciphertext.
BYOK_MASTER_KEY=
BYOK_MASTER_KEY_ID=
BYOK_PREVIOUS_KEYS={}
BYOK_RETIRED_KEY_IDS=[]
BYOK_RETIRED_KEY_HASHES=[]
BYOK_STORAGE_BACKEND=redis
# Dedicated persistent, non-evicting store in production. No memory fallback.
BYOK_REDIS_URL=redis://localhost:6380/0
PAYOS_CHECKSUM_KEY=dev-payos-checksum-secret-key-32b
# PAYOS_API_KEY=
