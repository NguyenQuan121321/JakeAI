  },
  "components": {
    "schemas": {
      "AnalyticsDashboard": {
        "properties": {
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id"
          },
          "tokens_processed": {
            "type": "integer",
            "title": "Tokens Processed"
          },
          "tokens_saved_cache": {
            "type": "integer",
            "title": "Tokens Saved Cache"
          },
          "cost_savings_usd": {
            "type": "number",
            "title": "Cost Savings Usd"
          },
          "savings_percentage": {
            "type": "number",
            "title": "Savings Percentage"
          },
          "prs_audited": {
            "type": "integer",
            "title": "Prs Audited"
          },
          "avg_ttft_ms": {
            "type": "number",
            "title": "Avg Ttft Ms"
          },
          "model_distribution": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Model Distribution"
          },
          "subscription_tier": {
            "type": "string",
            "title": "Subscription Tier"
          }
        },
        "type": "object",
        "required": [
          "tenant_id",
          "tokens_processed",
          "tokens_saved_cache",
          "cost_savings_usd",
          "savings_percentage",
          "prs_audited",
          "avg_ttft_ms",
          "model_distribution",
          "subscription_tier"
        ],
        "title": "AnalyticsDashboard",
        "description": "Telemetry metrics dashboard visualizing token efficiency and performance."
      },
      "BYOKKeyResponse": {
        "properties": {
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "masked_key": {
            "type": "string",
            "title": "Masked Key"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "tenant_id",
          "provider",
          "masked_key",
          "status"
        ],
        "title": "BYOKKeyResponse",
        "description": "Response returning masked key information."
      },
      "BYOKListResponse": {
        "properties": {
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id"
          },
          "keys": {
            "items": {
              "$ref": "#/components/schemas/BYOKProviderItem"
            },
            "type": "array",
            "title": "Keys"
          }
        },
        "type": "object",
        "required": [
          "tenant_id",
          "keys"
        ],
        "title": "BYOKListResponse",
        "description": "List of configured provider keys for a tenant."
      },
      "BYOKProviderItem": {
        "properties": {
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "masked_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Masked Key"
          },
          "configured": {
            "type": "boolean",
            "title": "Configured"
          }
        },
        "type": "object",
        "required": [
          "provider",
          "masked_key",
          "configured"
        ],
        "title": "BYOKProviderItem",
        "description": "Provider key status item."
      },
      "BYOKStoreRequest": {
        "properties": {
          "provider": {
            "type": "string",
            "title": "Provider",
            "description": "LLM provider: openai, gemini, anthropic, or openrouter"
          },
          "api_key": {
            "type": "string",
            "minLength": 8,
            "title": "Api Key",
            "description": "Raw provider API key to encrypt"
          }
        },
        "type": "object",
        "required": [
          "provider",
          "api_key"
        ],
        "title": "BYOKStoreRequest",
        "description": "Request payload to register or update an LLM provider API key."
      },
      "ChangelogRequest": {
        "properties": {
          "pr_titles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Pr Titles",
            "description": "List of merged PR titles"
          },
          "commits": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Commits",
            "description": "List of commit messages"
          },
          "webhook_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Webhook Url",
            "description": "Optional Slack/Discord webhook to broadcast to"
          }
        },
        "type": "object",
        "title": "ChangelogRequest",
        "description": "Request payload to synthesize release notes from PR titles and commits."
      },
      "ChangelogResponse": {
        "properties": {
          "changelog_markdown": {
            "type": "string",
            "title": "Changelog Markdown"
          },
          "broadcast_sent": {
            "type": "boolean",
            "title": "Broadcast Sent"
          }
        },
        "type": "object",
        "required": [
          "changelog_markdown",
          "broadcast_sent"
        ],
        "title": "ChangelogResponse",
        "description": "Generated release notes and broadcast status."
      },
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "title": "Role",
            "description": "role: system, user, assistant"
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "message content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage",
        "description": "OpenAI-compatible message format."
      },
      "ChatStreamRequest": {
        "properties": {
          "prompt": {
            "type": "string",
            "maxLength": 8000,
            "title": "Prompt",
            "description": "User question or financial prompt",
            "default": ""
          },
          "query": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 8000
              },
              {
                "type": "null"
              }
            ],
            "title": "Query",
            "description": "Alias for prompt used by frontend widget"
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id",
            "description": "Optional conversation thread ID"
          },
          "parameters": {
            "additionalProperties": true,
            "type": "object",
            "title": "Parameters",
            "description": "Optional model execution parameters"
          }
        },
        "type": "object",
        "title": "ChatStreamRequest",
        "description": "Payload model for chat streaming requests supporting both prompt and query aliases."
      },
      "DocumentIngestRequest": {
        "properties": {
          "content": {
            "type": "string",
            "title": "Content",
            "description": "Raw document text to be chunked and indexed",
            "default": ""
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text",
            "description": "Alias for content"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "description": "Source document name, URL, or identifier",
            "default": "Internal Document"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata",
            "description": "Arbitrary metadata attached to each document chunk"
          },
          "chunk_size": {
            "type": "integer",
            "maximum": 4000.0,
            "minimum": 50.0,
            "title": "Chunk Size",
            "description": "Maximum characters per document chunk",
            "default": 500
          },
          "chunk_overlap": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Chunk Overlap",
            "description": "Character overlap between consecutive chunks",
            "default": 50
          }
        },
        "type": "object",
        "title": "DocumentIngestRequest",
        "description": "Payload for ingesting raw documents into tenant-isolated RAG indexes."
      },
      "DocumentIngestResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Ingestion status",
            "default": "success"
          },
          "indexed_chunks": {
            "type": "integer",
            "title": "Indexed Chunks",
            "description": "Total chunks generated and indexed"
          },
          "chunk_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Chunk Ids",
            "description": "Unique deterministic IDs of created chunks"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "description": "Document source identifier"
          },
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id",
            "description": "Tenant ID boundary where chunks reside"
          }
        },
        "type": "object",
        "required": [
          "indexed_chunks",
          "chunk_ids",
          "source",
          "tenant_id"
        ],
        "title": "DocumentIngestResponse",
        "description": "Outcome metadata of document ingestion pipeline execution."
      },
      "GatewayChatRequest": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "description": "Target model name",
            "default": "gemini-1.5-flash"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "minItems": 1,
            "title": "Messages",
            "description": "List of messages"
          },
          "temperature": {
            "type": "number",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Temperature",
