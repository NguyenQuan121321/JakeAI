meta {
  name: 03 — Budget Read
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/v1/finops/budget
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_a}}
}

headers {
  Content-Type: application/json
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Active budget exposes token quota and dollar limit", function() {
    const data = res.getBody();
    expect(data.tenant_id).to.equal(bru.getEnvVar("tenant_a"));
    expect(data.token_quota).to.be.a("number");
    expect(data.dollar_budget_usd === null || typeof data.dollar_budget_usd === "number").to.be.true;
  });
}
