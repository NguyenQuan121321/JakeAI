meta {
  name: 01 — Exact Cache Miss
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/gateway/chat/completions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token_a}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "model": "{{model}}",
    "messages": [
      {
        "role": "user",
        "content": "Verify exact cache miss for session {{correlation_id}}"
      }
    ],
    "temperature": 0.0,
    "stream": false
  }
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Initial request is an exact cache MISS", function() {
    const data = res.getBody();
    expect(data.cached).to.equal(false);
  });
}
