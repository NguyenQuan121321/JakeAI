meta {
  name: 02 — Configuration Check
  type: http
  seq: 2
}

get {
  url: {{base_url}}/health/ready
  body: none
  auth: none
}

headers {
  Content-Type: application/json
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Version and components are exposed", function() {
    const data = res.getBody();
    expect(data.status).to.equal("healthy");
    expect(data.version).to.be.a("string");
    expect(data.environment).to.be.a("string");
    expect(data.components).to.be.an("object");
    expect(data.components.api).to.equal("healthy");
  });
}
