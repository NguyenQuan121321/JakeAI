meta {
  name: 02 — Chat Validation
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/gateway/chat/completions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token_a}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "model": "{{model}}",
    "messages": [],
    "temperature": 3.5
  }
}

tests {
  test("Validation failure returns 422 Unprocessable Entity", function() {
    expect(res.getStatus()).to.equal(422);
  });
  test("Detail contains field validation errors", function() {
    const data = res.getBody();
    expect(data.detail).to.be.an("array");
  });
}
