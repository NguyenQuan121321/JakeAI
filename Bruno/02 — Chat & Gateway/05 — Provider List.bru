meta {
  name: 05 — Provider List
  type: http
  seq: 5
}

get {
  url: {{base_url}}/api/v1/gateway/models
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_a}}
}

headers {
  Content-Type: application/json
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Model catalog returns model entries", function() {
    const data = res.getBody();
    expect(data.object).to.equal("list");
    expect(data.data.length).to.be.greaterThan(0);
    const modelIds = data.data.map(m => m.id);
    expect(modelIds).to.include("gemini-1.5-flash");
  });
}
