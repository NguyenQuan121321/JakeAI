meta {
  name: 04 — Gateway Chat
  type: http
  seq: 4
}

post {
  url: {{base_url}}/v1/chat/completions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token_a}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "model": "{{model}}",
    "messages": [
      {
        "role": "user",
        "content": "Define debt service coverage ratio (DSCR)."
      }
    ],
    "stream": false
  }
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("OpenAI compatibility format is preserved", function() {
    const data = res.getBody();
    expect(data.object).to.equal("chat.completion");
    expect(data.choices).to.be.an("array");
  });
}
