meta {
  name: 01 — Provider Timeout
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/gateway/chat/completions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token_a}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "model": "{{model}}",
    "messages": [
      {
        "role": "user",
        "content": "Timeout normalization contract test"
      }
    ],
    "stream": false
  }
}

tests {
  test("Status code is 200 or typed provider timeout (408/503)", function() {
    expect([200, 408, 503]).to.include(res.getStatus());
  });
}
