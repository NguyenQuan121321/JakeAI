}

body:json {
  {
    "model": "deepseek-chat",
    "messages": [
      {
        "role": "user",
        "content": "Test multi-provider failover fallback"
      }
    ],
    "stream": false
  }
}

tests {
  test("Failover returns 200 OK or graceful degradation", function() {
    expect([200, 502, 503]).to.include(res.getStatus());
  });
}
