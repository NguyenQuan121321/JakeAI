meta {
  name: 03 — Query
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/rag/query
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token_a}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "query": "What is JakeAI cache architecture and transaction volume in 2026?",
    "top_k": 3,
    "select_context": true
  }
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Query retrieves matching chunks", function() {
    const data = res.getBody();
    expect(data.chunks).to.be.an("array");
    expect(data.total_candidates).to.be.greaterThan(0);
  });
}
