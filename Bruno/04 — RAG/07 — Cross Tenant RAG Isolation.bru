meta {
  name: 07 — Cross Tenant RAG Isolation
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/v1/rag/query
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token_b}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "query": "JakeAI Financial Platform Architecture $100M",
    "top_k": 5
  }
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Tenant B cannot retrieve Tenant A documents", function() {
    const data = res.getBody();
    expect(data.tenant_id).to.equal(bru.getEnvVar("tenant_b"));
    expect(data.chunks.length).to.equal(0);
  });
}
