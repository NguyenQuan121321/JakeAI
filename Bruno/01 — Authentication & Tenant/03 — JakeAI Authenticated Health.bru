meta {
  name: 03 — JakeAI Authenticated Health
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/v1/health
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_a}}
}

headers {
  Content-Type: application/json
  X-Correlation-ID: {{correlation_id}}
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Correlation ID is preserved in response headers", function() {
    expect(res.getHeader("x-correlation-id")).to.equal(bru.getEnvVar("correlation_id"));
  });
}
