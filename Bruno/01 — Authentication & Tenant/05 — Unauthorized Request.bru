meta {
  name: 05 — Unauthorized Request
  type: http
  seq: 5
}

get {
  url: {{base_url}}/api/v1/byok/keys
  body: none
  auth: none
}

headers {
  Content-Type: application/json
}

tests {
  test("Missing token returns 401 Unauthorized", function() {
    expect(res.getStatus()).to.equal(401);
  });
  test("WWW-Authenticate challenge header is returned", function() {
    expect(res.getHeader("www-authenticate")).to.include("Bearer");
  });
}
