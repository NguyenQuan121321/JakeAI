meta {
  name: 07 — Expired Token
  type: http
  seq: 7
}

get {
  url: {{base_url}}/api/v1/byok/keys
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_expired}}
}

headers {
  Content-Type: application/json
}

tests {
  test("Expired token returns 401 Unauthorized", function() {
    expect(res.getStatus()).to.equal(401);
  });
  test("Error explicitly reports expired signature", function() {
    const data = res.getBody();
    expect(data.detail).to.equal("Authentication token has expired");
  });
}
