meta {
  name: 02 — Store Access Token
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/health
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_a}}
}

headers {
  Content-Type: application/json
}

script:post-response {
  let token = bru.getVar("token_a");
  if (!token) {
    token = bru.getEnvVar("token_a");
    if (token) {
      bru.setVar("token_a", token);
    }
  }
}

tests {
  test("Access token is configured and valid", function() {
    const token = bru.getVar("token_a") || bru.getEnvVar("token_a");
    expect(token).to.be.a("string");
    expect(token.length).to.be.greaterThan(20);
    expect(res.getStatus()).to.equal(200);
  });
}
