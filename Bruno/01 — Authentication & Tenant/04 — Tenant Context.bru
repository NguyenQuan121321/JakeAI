meta {
  name: 04 — Tenant Context
  type: http
  seq: 4
}

get {
  url: {{base_url}}/api/v1/byok/keys
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_a}}
}

headers {
  Content-Type: application/json
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Tenant context is correctly extracted from token claims", function() {
    const data = res.getBody();
    expect(data.tenant_id).to.equal(bru.getEnvVar("tenant_a"));
    expect(data.keys).to.be.an("array");
  });
}
