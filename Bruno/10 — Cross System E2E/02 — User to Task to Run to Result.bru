meta {
  name: 02 — User → Task → Run → Result
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/agent/tasks/{{task_id}}/runs/{{run_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_a}}
}

headers {
  Content-Type: application/json
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Run state reached valid progression", function() {
    const data = res.getBody();
    expect(data.run_id).to.equal(bru.getVar("run_id") || bru.getEnvVar("run_id"));
  });
}
