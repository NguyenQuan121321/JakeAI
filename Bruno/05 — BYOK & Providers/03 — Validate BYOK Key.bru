meta {
  name: 03 — Validate BYOK Key
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/byok/keys/validate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token_a}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "provider": "{{provider}}",
    "api_key": "{{gemini_api_key}}"
  }
}

tests {
  test("Validation probe returns 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Verdict returned as boolean", function() {
    const data = res.getBody();
    expect(data.provider).to.equal(bru.getEnvVar("provider"));
    expect(data.is_valid).to.be.a("boolean");
  });
}
