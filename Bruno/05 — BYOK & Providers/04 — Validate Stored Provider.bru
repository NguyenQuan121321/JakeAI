meta {
  name: 04 — Validate Stored Provider
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/byok/keys/{{provider}}/validate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_a}}
}

headers {
  Content-Type: application/json
}

tests {
  test("Stored key probe returns 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Verdict returned as boolean", function() {
    const data = res.getBody();
    expect(data.provider).to.equal(bru.getEnvVar("provider"));
    expect(data.is_valid).to.be.a("boolean");
  });
}
