meta {
  name: 02 — Add BYOK Key
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/byok/keys
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token_a}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "provider": "{{provider}}",
    "api_key": "{{gemini_api_key}}",
    "validate_key": false
  }
}

tests {
  test("Status code is 201 Created", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("Masked key returned with active status", function() {
    const data = res.getBody();
    expect(data.provider).to.equal(bru.getEnvVar("provider"));
    expect(data.masked_key.includes("...") || data.masked_key.includes("***")).to.be.true;
    expect(["active", "configured"]).to.include(data.status);
  });
}
