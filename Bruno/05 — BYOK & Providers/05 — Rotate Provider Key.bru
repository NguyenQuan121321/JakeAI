meta {
  name: 05 — Rotate Provider Key
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/v1/byok/keys/{{provider}}/rotate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token_a}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "new_api_key": "new-rotated-secret-key-12345",
    "validate_key": false
  }
}

tests {
  test("Rotation returns 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Key rotated with active status", function() {
    const data = res.getBody();
    expect(data.provider).to.equal(bru.getEnvVar("provider"));
    expect(["active", "configured"]).to.include(data.status);
  });
}
