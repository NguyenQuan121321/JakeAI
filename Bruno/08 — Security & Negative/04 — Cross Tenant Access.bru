meta {
  name: 04 — Cross Tenant Access
  type: http
  seq: 4
}

get {
  url: {{base_url}}/api/v1/agent/tasks/{{task_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_b}}
}

headers {
  Content-Type: application/json
}

tests {
  test("ATTACK: Tenant B accessing Tenant A task. EXPECTED: 403 or 404", function() {
    expect([403, 404]).to.include(res.getStatus());
  });
}
