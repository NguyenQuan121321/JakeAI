meta {
  name: 08 — Tool Authorization
  type: http
  seq: 8
}

post {
  url: {{base_url}}/api/v1/coding/tool-result
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "run_id": "test-run",
    "tool_name": "terminal_exec",
    "result": "executed"
  }
}

tests {
  test("ATTACK: Unauthenticated tool result injection. EXPECTED: 401 or 403", function() {
    expect([401, 403, 404]).to.include(res.getStatus());
  });
}
