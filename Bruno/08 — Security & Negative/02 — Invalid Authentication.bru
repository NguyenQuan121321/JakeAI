meta {
  name: 02 — Invalid Authentication
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/finops/summary
  body: none
  auth: bearer
}

auth:bearer {
  token: forged.signature.tampered.token
}

headers {
  Content-Type: application/json
}

tests {
  test("ATTACK: Forged JWT token. EXPECTED: 401 Unauthorized", function() {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().detail).to.equal("Invalid authentication token");
  });
}
