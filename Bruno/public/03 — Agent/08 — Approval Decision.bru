meta {
  name: 08 — Approval Decision
  type: http
  seq: 8
}

post {
  url: {{base_url}}/api/v1/agent/tasks/{{task_id}}/runs/{{run_id}}/approvals/{{approval_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{approval_approver_token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "approved": true,
    "action_hash": "{{approval_action_hash}}"
  }
}

tests {
  test("Assigned separate approver authorizes the bound action", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("approved");
  });
}
