meta {
  name: 13 — Consume Bound Approval
  type: http
  seq: 13
}

post {
  url: {{base_url}}/api/v1/agent/tasks/{{task_id}}/runs/{{run_id}}/approvals/{{approval_id}}/consume
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token_a}}
}

headers {
  Content-Type: application/json
}

body:json {
  { "action_hash": "{{approval_action_hash}}" }
}

tests {
  test("Requester publishes the approved calculator result once", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("consumed");
    expect(res.getBody().result.result).to.equal(42);
  });
}
