meta {
  name: 03 — Validate BYOK Key
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/byok/keys/validate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token_a}}
}

body:json {
  {
    "provider": "gemini",
    "api_key": "{{gemini_api_key}}"
  }
}

tests {
  test("Validate key probe executes", function() {
    expect([200, 400]).to.include(res.getStatus());
  });
}
