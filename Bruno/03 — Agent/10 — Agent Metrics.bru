meta {
  name: 10 — Agent Metrics
  type: http
  seq: 10
}

get {
  url: {{base_url}}/api/v1/agent/metrics
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_a}}
}

headers {
  Content-Type: application/json
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Agent metrics snapshot is populated", function() {
    const data = res.getBody();
    expect(data.tasks_created).to.be.a("number");
    expect(data.runs_started !== undefined ? data.runs_started : data.runs_created).to.be.a("number");
  });
}
