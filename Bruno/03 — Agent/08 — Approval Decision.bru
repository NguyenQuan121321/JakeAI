meta {
  name: 08 — Approval Decision
  type: http
  seq: 8
}

post {
  url: {{base_url}}/api/v1/agent/tasks/{{task_id}}/runs/{{run_id}}/approvals/{{approval_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token_a}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "approved": true,
    "reason": "Operator authorized execution of dangerous action step"
  }
}

tests {
  test("Status is 200 OK or 404/405/409/422 (if no pending approval active)", function() {
    expect([200, 404, 405, 409, 422]).to.include(res.getStatus());
  });
}
