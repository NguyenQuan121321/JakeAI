meta {
  name: 07 — Pending Approvals
  type: http
  seq: 7
}

get {
  url: {{base_url}}/api/v1/agent/approvals/pending
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_a}}
}

headers {
  Content-Type: application/json
}

script:post-response {
  if (res.getStatus() === 200) {
    const data = res.getBody();
    if (Array.isArray(data) && data.length > 0) {
      bru.setVar("approval_id", data[0].approval_id);
      bru.setEnvVar("approval_id", data[0].approval_id);
      console.log("Captured approval_id: " + data[0].approval_id);
    }
  }
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Returns array of pending approval requests", function() {
    const data = res.getBody();
    expect(data).to.be.an("array");
  });
}
