diff --git a/.github/workflows/j02-paired-performance.yml b/.github/workflows/j02-paired-performance.yml
new file mode 100644
--- /dev/null
+++ b/.github/workflows/j02-paired-performance.yml
@@ -0,0 +1,81 @@
+name: J02 additive paired performance contract
+
+on:
+  pull_request:
+    branches: [main]
+    types: [opened, synchronize, reopened, ready_for_review]
+
+permissions:
+  contents: read
+
+concurrency:
+  group: j02-paired-${{ github.event.pull_request.number }}
+  cancel-in-progress: true
+
+jobs:
+  paired:
+    name: J02 paired candidate versus pinned pre-J02 main
+    if: >-
+      github.repository == 'NguyenQuan121321/JakeAI' &&
+      github.event.repository.private == false &&
+      github.event.pull_request.head.repo.full_name == github.repository &&
+      github.event.pull_request.head.ref == 'codex/j02-review-fixes'
+    runs-on: ubuntu-24.04
+    timeout-minutes: 20
+    services:
+      candidate-redis:
+        image: redis@sha256:8da19c7399dca900c6822a1cf30f9d2285585e2c4b457ff4095b0f4500054d3f
+        ports: ['6379:6379']
+        options: --health-cmd "redis-cli ping" --health-interval 5s --health-timeout 5s --health-retries 10
+      control-redis:
+        image: redis@sha256:8da19c7399dca900c6822a1cf30f9d2285585e2c4b457ff4095b0f4500054d3f
+        ports: ['6380:6379']
+        options: --health-cmd "redis-cli ping" --health-interval 5s --health-timeout 5s --health-retries 10
+      candidate-qdrant:
+        image: qdrant/qdrant@sha256:d774e7bb65744454984c6021637a0da89271f30df15e48601a9fafc926d26b1f
+        ports: ['6333:6333', '6334:6334']
+      control-qdrant:
+        image: qdrant/qdrant@sha256:d774e7bb65744454984c6021637a0da89271f30df15e48601a9fafc926d26b1f
+        ports: ['6335:6333', '6336:6334']
+    env:
+      ENVIRONMENT: test
+      J02_PAIRED_CONTRACT: review-v1
+      J02_CANDIDATE_REDIS_CONTAINER: ${{ job.services['candidate-redis'].id }}
+      J02_CONTROL_REDIS_CONTAINER: ${{ job.services['control-redis'].id }}
+      J02_CANDIDATE_QDRANT_CONTAINER: ${{ job.services['candidate-qdrant'].id }}
+      J02_CONTROL_QDRANT_CONTAINER: ${{ job.services['control-qdrant'].id }}
+    steps:
+      - name: Checkout exact candidate source
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with:
+          ref: ${{ github.event.pull_request.head.sha }}
+          fetch-depth: 0
+          persist-credentials: false
+      - name: Checkout immutable pre-J02 main control
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with:
+          ref: 64f087ca708200a2c81ba646acfa6112876f601c
+          path: paired-pre-j02-control
+          persist-credentials: false
+      - name: Set up common Python
+        uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0
+        with:
+          python-version: '3.12.15'
+      - name: Install shared constrained dependencies
+        run: >-
+          python -m pip install -r backend/requirements.txt
+          -c scripts/j02/calibration-20261102.constraints.txt
+      - name: Require deterministic contract regressions
+        working-directory: backend
+        run: pytest tests/unit/test_paired_performance.py tests/performance/test_confirmation_contract.py -v
+      - name: One paired comparison with real isolated stores
+        run: >-
+          python scripts/j02_paired_benchmark.py
+          --control paired-pre-j02-control --output paired-performance.json
+      - name: Preserve comparison result and active-contract boundary
+        if: ${{ always() }}
+        run: |
+          if [ -f paired-performance.json ]; then
+            cat paired-performance.json
+          fi
+          echo 'Paired CI comparison only. Existing v1 remains independently blocking; no G4 or J02 acceptance. Standard hosted runner, additional budget USD0.' >> "$GITHUB_STEP_SUMMARY"
