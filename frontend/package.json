{
  "name": "@jakeai/widget",
  "version": "0.1.0",
  "description": "Enterprise embedded AI companion widget with Shadow DOM and animated Corgi mascot",
  "type": "module",
  "main": "./dist/jake-ai-widget.umd.js",
  "module": "./dist/jake-ai-widget.es.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
